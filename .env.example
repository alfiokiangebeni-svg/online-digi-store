# Copier ce fichier en .env.local et remplir les valeurs.
# Ne JAMAIS committer .env.local.

# --- Application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stockage Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=digi-store-files
DOWNLOAD_LINK_TTL_HOURS=24

# --- Agrégateur Mobile Money ---
PAYMENT_PROVIDER=flexpay        # flexpay | cinetpay | pawapay | maxicash
PAYMENT_API_URL=
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_TIMEOUT_SECONDS=120

# --- Taux de change ---
FX_API_URL=
FX_CDF_ROUNDING=50

# --- Notifications ---
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_PROVIDER_API_KEY=
SMS_SENDER_NAME=DigiStore

# --- Suivi ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
